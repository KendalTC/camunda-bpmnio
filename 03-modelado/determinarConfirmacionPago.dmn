  <decision id="Decision_04dp310" name="Determinar tipo de confirmación de pago">
    <variable id="Variable_1" name="Determinar tipo de confirmación de pago" typeRef="Any" />
    <decisionTable id="DecisionTable_0gn6ung">
      <input id="Input_1">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text>metodoPago</text>
        </inputExpression>
      </input>
      <output id="Output_1" name="requiereEspera" typeRef="boolean" />
      <rule id="DecisionRule_0awtvl2">
