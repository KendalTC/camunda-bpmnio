  <decision id="Decision_0jivutp" name="Determinar riesgo por cuotas">
    <variable id="Variable_1" name="Determinar riesgo por cuotas" typeRef="Any" />
    <decisionTable id="DecisionTable_1aari0q">
      <input id="Input_1">
        <inputExpression id="InputExpression_1" typeRef="number">
          <text>numeroCuotas</text>
        </inputExpression>
      </input>
      <output id="Output_1" name="requiereRevision" typeRef="boolean" />
      <rule id="DecisionRule_0rxyney">
        <inputEntry id="UnaryTests_0t7g02s">
          <text>&gt; 6</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_01sxwey">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0mccsol">
        <inputEntry id="UnaryTests_1yv29to">
          <text>&lt;= 6 </text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1rfz1yi">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
